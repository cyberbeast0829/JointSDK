prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: joint-sdk-can
Description: CyberBeast CAN/CAN-FD joint SDK (CyberBeast protocol), pure C99
URL: https://example.invalid/joint-sdk
Version: @PROJECT_VERSION@

# ⚠ 两个 -I 都要：公开头之间是**引号形式**互相引用的（`#include "joint_sdk.h"`），
#   安装后目录是 <prefix>/include/joint_sdk/。
Cflags: -I${includedir} -I${includedir}/joint_sdk
Libs: -L${libdir} -ljsdk_can

# 静态链接时才需要（`pkg-config --static --libs joint-sdk-can`）：
#   -lm   glibc 把 floor() 放在独立的 libm 里（MinGW 不需要 → Windows 上看不到这个缺口）
#   -ldl  hal_pcan.c 运行期 dlopen 加载 PCAN-Basic（macOS 上 dlopen 在 libSystem 里，无此库）
# 没有 pthread：本库不创建线程，控制循环由调用方驱动。
Libs.private: @JSDK_PC_LIBS_PRIVATE@
